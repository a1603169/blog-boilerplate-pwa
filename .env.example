# Copy to .env.local and fill in. .env.local is gitignored.

# --- /admin sign-in -------------------------------------------------------
ADMIN_PASSWORD=pick-a-password
# openssl rand -hex 32
ADMIN_SECRET=

# --- Committing posts from /admin -----------------------------------------
# Fine-grained PAT: https://github.com/settings/personal-access-tokens/new
#   Repository access -> Only select repositories -> this repo only
#   Permissions -> Repository permissions -> Contents: Read and write
GITHUB_TOKEN=
GITHUB_REPO=your-handle/your-repo
GITHUB_BRANCH=main

# --- Optional: GitHub sign-in (identity only; commits still use the PAT) --
# https://github.com/settings/developers -> New OAuth App
#   Authorization callback URL: http://localhost:3000/admin/auth/callback
# An OAuth App allows ONE callback URL, so register a second app for production.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Only this GitHub username may sign in. Without it, any GitHub account could.
ADMIN_GITHUB_LOGIN=your-handle
